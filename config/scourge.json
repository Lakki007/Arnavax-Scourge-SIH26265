{
  "allow_hosts": [
    "netbanking.mockbank.test"
  ],
  "trust": {
    "mode": "test_ca",
    "ca_der": "certs/test_ca.der"
  },
  "banks": {
    "netbanking.mockbank.test": {
      "name": "Mock Bank (synthetic)",
      "endpoints": [
        {
          "method": "GET",
          "path_prefix": "/api/fd/details",
          "disclosure": "body"
        },
        {
          "method": "GET",
          "path_prefix": "/api/accounts/summary",
          "disclosure": "object"
        }
      ],
      "content_type": "application/json",
      "select_key": "depositNo",
      "fields": {
        "status": "status",
        "balance": "currentBalance",
        "principal": "principal",
        "maturity": "maturityDate",
        "holders": "holders",
        "lien": "lien"
      },
      "required": [
        "status",
        "balance",
        "maturity",
        "lien"
      ],
      "active_values": [
        "ACTIVE"
      ],
      "inactive_values": [
        "CLOSED",
        "MATURED",
        "PREMATURELY CLOSED",
        "PRE CLOSED",
        "PREMATURE CLOSURE",
        "WITHDRAWN",
        "PAID",
        "LIQUIDATED",
        "INACTIVE"
      ],
      "lien_rules": {
        "version": "mockbank-lien/2026-10-31",
        "_note": "Exact, bank-specific meanings. Text is upper-cased and whitespace-collapsed, then compared WHOLE. Anything not listed is unknown (never a confirmation).",
        "in_favour_of_aicte": [
          "AICTE NEW DELHI (SECURITY DEPOSIT)",
          "LIEN MARKED IN FAVOUR OF MEMBER SECRETARY AICTE"
        ],
        "encumbrance_patterns": [
          "LOAN [0-9]+(\\.[0-9]{1,2})? AGAINST DEPOSIT",
          "OVERDRAFT [0-9]+(\\.[0-9]{1,2})? AGAINST DEPOSIT"
        ],
        "no_lien_values": [
          "NONE",
          "NIL",
          "NO LIEN",
          "NO LIEN IN FAVOUR OF AICTE",
          "AICTE LIEN REMOVED",
          "LIEN RELEASED",
          "LIEN MARKED OFF"
        ]
      },
      "holder_required": "MEMBER SECRETARY AICTE"
    }
  },
  "max_sent": 4096,
  "max_recv": 65536,
  "verifier_listen": "127.0.0.1:7047",
  "app_internal": "127.0.0.1:8080"
}
