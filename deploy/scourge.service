# systemd unit. Install the release to /opt/scourge (owned by user scourge), venv at /opt/scourge/venv.
[Unit]
Description=Scourge demo (app + verifier + synthetic banks)
After=network.target

[Service]
User=scourge
WorkingDirectory=/opt/scourge
EnvironmentFile=/etc/scourge.env
Environment=PATH=/opt/scourge/venv/bin:/usr/bin:/bin
ExecStart=/opt/scourge/scripts/run.sh
Restart=on-failure
RestartSec=3
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/scourge/var

[Install]
WantedBy=multi-user.target
